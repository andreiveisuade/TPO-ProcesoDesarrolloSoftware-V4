@startuml clases-v4-mvc
title Dashboard de préstamos V4 — capas MVC
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "controller" {
  class AuthController
  class ClienteController <<RestController>> {
    - clienteService : ClienteService
    + crear(request : ClienteRequest) : ResponseEntity<ClienteResponse>
    + buscarPorDni(dni : String) : ResponseEntity<ClienteResponse>
    + deuda(dni : String) : ResponseEntity<DeudaClienteResponse>
    + listarTodos() : ResponseEntity<List<ClienteResponse>>
  }
  class CreditoController <<RestController>> {
    - creditoService : CreditoService
    + crear(request : CreditoRequest) : ResponseEntity<CreditoResponse>
    + listarTodos() : ResponseEntity<List<CreditoResponse>>
    + buscarPorId(id : Long) : ResponseEntity<CreditoResponse>
    + listarPorCliente(dni : String) : ResponseEntity<List<CreditoResponse>>
    + anularCredito(id : Long, usuario : IUsuario) : ResponseEntity<Void>
  }
  class CobranzaController <<RestController>> {
    - cobranzaService : CobranzaService
    + registrar(request : CobranzaRequest) : ResponseEntity<CobranzaResponse>
    + listarPorCredito(idCredito : Long) : ResponseEntity<List<CobranzaResponse>>
    + anularCobranza(id : Long, usuario : IUsuario) : ResponseEntity<Void>
  }
  class AdminController <<RestController>> {
    - adminService : AdminService
    + listarUsuarios() : List<UsuarioResponse>
    + crearUsuario(request : AltaUsuarioRequest) : ResponseEntity<UsuarioResponse>
    + actualizarPermisos(id : Long, request : PermisosRequest) : UsuarioResponse
    + actualizarRol(id : Long, request : RolRequest) : UsuarioResponse
    + actualizarActivo(id : Long, request : ActivoRequest) : UsuarioResponse
  }
  class SupervisorController <<RestController>> {
    - adminService : AdminService
    + listarUsuarios() : List<UsuarioResponse>
    + actualizarPermisosAnulacion(id : Long, request : PermisosRequest) : UsuarioResponse
  }
  class DashboardController <<RestController>> {
    - dashboardService : DashboardService
    + obtenerEstadisticas() : ResponseEntity<DashboardStatsResponse>
  }
}

package "service" {
  interface AuthService
  interface ClienteService {
    + crear(request : ClienteRequest) : ClienteResponse
    + buscarPorDni(dni : String) : ClienteResponse
    + listarTodos() : List<ClienteResponse>
    + deuda(dni : String) : DeudaClienteResponse
  }
  interface CreditoService {
    + crear(request : CreditoRequest) : CreditoResponse
    + buscarPorId(id : Long) : CreditoResponse
    + listarTodos() : List<CreditoResponse>
    + listarPorCliente(dniCliente : String) : List<CreditoResponse>
    + anularCredito(id : Long, usuario : IUsuario) : void
  }
  interface CobranzaService {
    + registrar(request : CobranzaRequest) : CobranzaResponse
    + listarPorCredito(idCredito : Long) : List<CobranzaResponse>
    + anularCobranza(id : Long, usuario : IUsuario) : void
  }
  interface AdminService {
    + listarUsuarios() : List<UsuarioResponse>
    + crearUsuario(request : AltaUsuarioRequest) : UsuarioResponse
    + actualizarPermisos(id : Long, request : PermisosRequest) : UsuarioResponse
    + actualizarRol(id : Long, request : RolRequest) : UsuarioResponse
    + actualizarActivo(id : Long, request : ActivoRequest) : UsuarioResponse
  }
  interface DashboardService {
    + obtenerEstadisticasGenerales() : DashboardStatsResponse
  }
}

package "service.impl" {
  class AuthServiceImpl
  class CreditoServiceImpl
  class CobranzaServiceImpl
  class ClienteServiceImpl <<Service>> {
    - clienteRepository : ClienteRepository
    - creditoRepository : CreditoRepository
    + crear(request : ClienteRequest) : ClienteResponse
    + buscarPorDni(dni : String) : ClienteResponse
    + listarTodos() : List<ClienteResponse>
    + deuda(dni : String) : DeudaClienteResponse
  }
  class AdminServiceImpl <<Service>> {
    - usuarioRepository : UsuarioRepository
    - authService : AuthService
    + listarUsuarios() : List<UsuarioResponse>
    + crearUsuario(request : AltaUsuarioRequest) : UsuarioResponse
    + actualizarPermisos(id : Long, request : PermisosRequest) : UsuarioResponse
    + actualizarRol(id : Long, request : RolRequest) : UsuarioResponse
    + actualizarActivo(id : Long, request : ActivoRequest) : UsuarioResponse
    - buscar(id : Long) : Usuario
  }
  class DashboardServiceImpl <<Service>> {
    - clienteRepository : ClienteRepository
    - creditoRepository : CreditoRepository
    - cobranzaRepository : CobranzaRepository
    + obtenerEstadisticasGenerales() : DashboardStatsResponse
  }
}

package "repository" {
  interface ClienteRepository <<JpaRepository · Cliente, String>> {
  }
  interface CreditoRepository <<JpaRepository · Credito, Long>> {
    + buscarPorCliente(dni : String) : List<Credito>
    + bloquearPorId(id : Long) : Optional<Credito>
    + sumarDeudaOriginalNoAnulada() : BigDecimal
  }
  interface CuotaRepository <<JpaRepository · Cuota, Long>> {
    + buscarPorCreditoYNumero(idCredito : Long, numero : Integer) : Optional<Cuota>
  }
  interface CobranzaRepository <<JpaRepository · Cobranza, Long>> {
    + buscarPorCredito(idCredito : Long) : List<Cobranza>
    + sumarImporteNoAnulado() : BigDecimal
  }
  interface UsuarioRepository <<JpaRepository · Usuario, Long>> {
    + findByUsername(username : String) : Optional<Usuario>
    + existsByUsername(username : String) : boolean
  }
}

ClienteController "0..*" --> "1" ClienteService : delega en
CreditoController "0..*" --> "1" CreditoService : delega en
CobranzaController "0..*" --> "1" CobranzaService : delega en
AdminController "0..*" --> "1" AdminService : delega en
SupervisorController "0..*" --> "1" AdminService : delega en
DashboardController "0..*" --> "1" DashboardService : delega en
CreditoController "1" ..> "1" IUsuario : recibe al autenticado como
CobranzaController "1" ..> "1" IUsuario : recibe al autenticado como

ClienteService <|.. ClienteServiceImpl : implementa
CreditoService <|.. CreditoServiceImpl : implementa
CobranzaService <|.. CobranzaServiceImpl : implementa
AdminService <|.. AdminServiceImpl : implementa
DashboardService <|.. DashboardServiceImpl : implementa
CreditoService ..> IUsuario : recibe
CobranzaService ..> IUsuario : recibe

ClienteServiceImpl "0..*" --> "1" ClienteRepository : guarda y busca en
ClienteServiceImpl "0..*" --> "1" CreditoRepository : busca créditos en
CreditoServiceImpl "0..*" --> "1" CreditoRepository : guarda y busca en
CreditoServiceImpl "0..*" --> "1" ClienteRepository : busca al cliente en
CobranzaServiceImpl "0..*" --> "1" CobranzaRepository : guarda y busca en
CobranzaServiceImpl "0..*" --> "1" CuotaRepository : busca la cuota en
CobranzaServiceImpl "0..*" --> "1" CreditoRepository : bloquea el crédito en
AdminServiceImpl "0..*" --> "1" UsuarioRepository : guarda y busca en
DashboardServiceImpl "0..*" --> "1" ClienteRepository : cuenta en
DashboardServiceImpl "0..*" --> "1" CreditoRepository : suma en
DashboardServiceImpl "0..*" --> "1" CobranzaRepository : suma en

ClienteServiceImpl "1" ..> "0..*" Cliente : da de alta
ClienteServiceImpl "1" ..> "1" Cartera : consulta la deuda en
DashboardServiceImpl "1" ..> "1" Cartera : consulta saldo y mora en
DashboardServiceImpl "1" ..> "1" EstadoCredito : cuenta vigentes según
AdminServiceImpl "1" ..> "0..*" Usuario : administra
AdminServiceImpl "1" ..> "1" Permisos : otorga

ClienteRepository ..> Cliente : persiste
CreditoRepository ..> Credito : persiste
CuotaRepository ..> Cuota : persiste
CobranzaRepository ..> Cobranza : persiste
UsuarioRepository ..> Usuario : persiste
