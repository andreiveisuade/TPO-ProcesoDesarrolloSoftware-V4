@startuml clases-v4-mvc
title Dashboard de préstamos V4 — capas MVC
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 60
hide <<component>> members

package "Vista (React, frontend/src/api)" as Vista {
  class "auth.js" as VAuth <<component>>
  class "clientes.js" as VClientes <<component>>
  class "creditos.js" as VCreditos <<component>>
  class "cobranzas.js" as VCobranzas <<component>>
  class "admin.js" as VAdmin <<component>>
  class "supervisor.js" as VSupervisor <<component>>
  class "dashboard.js" as VDashboard <<component>>
}

package "Controlador (controller)" as Controlador {
  class AuthController <<RestController>> {
    - authService : AuthService
    + registrar(RegisterRequest) : AuthResponse
    + login(LoginRequest) : AuthResponse
    + actual(IUsuario) : AuthResponse
  }
  class ClienteController <<RestController>> {
    - clienteService : ClienteService
    + crear(ClienteRequest) : ClienteResponse
    + buscarPorDni(String) : ClienteResponse
    + listarTodos() : List<ClienteResponse>
    + deuda(String) : DeudaClienteResponse
  }
  class CreditoController <<RestController>> {
    - creditoService : CreditoService
    + crear(CreditoRequest) : CreditoResponse
    + buscarPorId(Long) : CreditoResponse
    + listarTodos() : List<CreditoResponse>
    + listarPorCliente(String) : List<CreditoResponse>
    + anularCredito(Long, IUsuario) : void
  }
  class CobranzaController <<RestController>> {
    - cobranzaService : CobranzaService
    + registrar(CobranzaRequest) : CobranzaResponse
    + listarPorCredito(Long) : List<CobranzaResponse>
    + anularCobranza(Long, IUsuario) : void
  }
  class AdminController <<RestController>> {
    - adminService : AdminService
    + listarUsuarios() : List<UsuarioResponse>
    + crearUsuario(AltaUsuarioRequest) : UsuarioResponse
    + actualizarPermisos(Long, PermisosRequest) : UsuarioResponse
    + actualizarRol(Long, RolRequest) : UsuarioResponse
    + actualizarActivo(Long, ActivoRequest) : UsuarioResponse
  }
  class SupervisorController <<RestController>> {
    - adminService : AdminService
    + listarUsuarios() : List<UsuarioResponse>
    + actualizarPermisosAnulacion(Long, PermisosRequest) : UsuarioResponse
  }
  class DashboardController <<RestController>> {
    - dashboardService : DashboardService
    + obtenerEstadisticas() : DashboardStatsResponse
  }
}

package "Modelo: servicios (service)" as Servicios {
  interface AuthService <<Facade>> {
    + registrar(RegisterRequest) : AuthResponse
    + registrarConRol(RegisterRequest, Rol) : UsuarioResponse
    + login(LoginRequest) : AuthResponse
    + actual(String) : AuthResponse
  }
  interface ClienteService {
    + crear(ClienteRequest) : ClienteResponse
    + buscarPorDni(String) : ClienteResponse
    + listarTodos() : List<ClienteResponse>
    + deuda(String) : DeudaClienteResponse
  }
  interface CreditoService {
    + crear(CreditoRequest) : CreditoResponse
    + buscarPorId(Long) : CreditoResponse
    + listarTodos() : List<CreditoResponse>
    + listarPorCliente(String) : List<CreditoResponse>
    + anularCredito(Long, IUsuario) : void
  }
  interface CobranzaService {
    + registrar(CobranzaRequest) : CobranzaResponse
    + listarPorCredito(Long) : List<CobranzaResponse>
    + anularCobranza(Long, IUsuario) : void
  }
  interface AdminService {
    + listarUsuarios() : List<UsuarioResponse>
    + crearUsuario(AltaUsuarioRequest) : UsuarioResponse
    + actualizarPermisos(Long, PermisosRequest) : UsuarioResponse
    + actualizarRol(Long, RolRequest) : UsuarioResponse
    + actualizarActivo(Long, ActivoRequest) : UsuarioResponse
  }
  interface DashboardService {
    + obtenerEstadisticasGenerales() : DashboardStatsResponse
  }
  class AuthServiceImpl <<Facade>> {
    - usuarioRepository : UsuarioRepository
    - passwordEncoder : PasswordEncoder
    - authenticationManager : AuthenticationManager
    - tokenService : TokenService
  }
  class ClienteServiceImpl {
    - clienteRepository : ClienteRepository
    - creditoRepository : CreditoRepository
  }
  class CreditoServiceImpl {
    - creditoRepository : CreditoRepository
    - clienteRepository : ClienteRepository
  }
  class CobranzaServiceImpl {
    - cobranzaRepository : CobranzaRepository
    - cuotaRepository : CuotaRepository
    - creditoRepository : CreditoRepository
  }
  class AdminServiceImpl {
    - usuarioRepository : UsuarioRepository
    - authService : AuthService
  }
  class DashboardServiceImpl {
    - clienteRepository : ClienteRepository
    - creditoRepository : CreditoRepository
    - cobranzaRepository : CobranzaRepository
  }
}

package "Modelo: persistencia (repository, Spring Data JPA)" as Repos {
  interface ClienteRepository <<JpaRepository<Cliente, String>>> {
    + findById(String) : Optional<Cliente>
    + existsById(String) : boolean
  }
  interface CreditoRepository <<JpaRepository<Credito, Long>>> {
    + findById(Long) : Optional<Credito>
    + findAll() : List<Credito>
    + buscarPorCliente(String) : List<Credito>
    + bloquearPorId(Long) : Optional<Credito>
    + sumarDeudaOriginalNoAnulada() : BigDecimal
  }
  interface CuotaRepository <<JpaRepository<Cuota, Long>>> {
    + buscarPorCreditoYNumero(Long, Integer) : Optional<Cuota>
  }
  interface CobranzaRepository <<JpaRepository<Cobranza, Long>>> {
    + buscarPorCredito(Long) : List<Cobranza>
    + sumarImporteNoAnulado() : BigDecimal
  }
  interface UsuarioRepository <<JpaRepository<Usuario, Long>>> {
    + findByUsername(String) : Optional<Usuario>
    + existsByUsername(String) : boolean
  }
}

VAuth ..> AuthController
VClientes ..> ClienteController
VCreditos ..> CreditoController
VCobranzas ..> CobranzaController
VAdmin ..> AdminController
VSupervisor ..> SupervisorController
VDashboard ..> DashboardController

AuthController --> "1" AuthService
ClienteController --> "1" ClienteService
CreditoController --> "1" CreditoService
CobranzaController --> "1" CobranzaService
AdminController --> "1" AdminService
SupervisorController --> "1" AdminService
DashboardController --> "1" DashboardService

AuthService <|.. AuthServiceImpl
ClienteService <|.. ClienteServiceImpl
CreditoService <|.. CreditoServiceImpl
CobranzaService <|.. CobranzaServiceImpl
AdminService <|.. AdminServiceImpl
AdminServiceImpl --> "1" AuthService : alta por la Facade
DashboardService <|.. DashboardServiceImpl

Servicios ..down.> Repos : cada *ServiceImpl usa los\nrepositories de sus atributos

note as Leyenda
  Cada módulo de frontend/src/api llama por HTTP a /api/<recurso>.
  Cada *ServiceImpl implementa las operaciones de su interfaz.
  Las entidades del modelo (Credito, Cuota, Cartera, ...) están en clases-v4-modelo;
  JWT, Spring Security y la Facade de autenticación, en clases-v4-seguridad.
  CreditoServiceImpl, ClienteServiceImpl y DashboardServiceImpl son Client del Composite (tipan Deuda).
  Omitidos: DTOs (estructuras sin comportamiento), excepciones,
  configuración y GlobalExceptionHandler (@RestControllerAdvice).
end note
@enduml

@startuml clases-v4-seguridad
title Dashboard de préstamos V4 — seguridad, Facade y Adapter
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Facade: autenticación" {
  class AuthController <<Client>> {
    - authService : AuthService
    + registrar(RegisterRequest) : AuthResponse
    + login(LoginRequest) : AuthResponse
    + actual(IUsuario) : AuthResponse
  }
  interface AuthService <<Facade>> {
    + registrar(RegisterRequest) : AuthResponse
    + registrarConRol(RegisterRequest, Rol) : UsuarioResponse
    + login(LoginRequest) : AuthResponse
    + actual(String) : AuthResponse
  }
  class AuthServiceImpl <<Facade>> {
    - usuarioRepository : UsuarioRepository
    - passwordEncoder : PasswordEncoder
    - authenticationManager : AuthenticationManager
    - tokenService : TokenService
    + registrar(RegisterRequest) : AuthResponse
    + registrarConRol(RegisterRequest, Rol) : UsuarioResponse
    + login(LoginRequest) : AuthResponse
    + actual(String) : AuthResponse
    - crear(RegisterRequest, Rol) : Usuario
    - buscar(String) : Usuario
  }
  class AdminServiceImpl <<Client>> {
    - authService : AuthService
    + crearUsuario(AltaUsuarioRequest) : UsuarioResponse
  }
}

package "Subsistema (no conoce a la Facade)" {
  interface "AuthenticationManager (Spring)" as AuthenticationManager {
    + authenticate(Authentication) : Authentication
  }
  interface "PasswordEncoder (Spring)" as PasswordEncoder {
    + encode(CharSequence) : String
  }
  interface UsuarioRepository <<JpaRepository<Usuario, Long>>> {
    + findByUsername(String) : Optional<Usuario>
    + existsByUsername(String) : boolean
  }
  package "Adapter 1: JWT (jjwt)" {
    interface TokenService <<Target>> {
      + generarToken(String) : String
      + extraerUsername(String) : Optional<String>
    }
    class JwtUtil <<Adapter>> {
      - key : SecretKey
      - parser : JwtParser
      - expirationMs : long
      + generarToken(String) : String
      + extraerUsername(String) : Optional<String>
    }
    interface "JwtParser (jjwt)" as JwtParser <<Adaptee>> {
      + parseSignedClaims(CharSequence) : Jws<Claims>
    }
    class "Jwts (jjwt)" as Jwts <<Adaptee>> {
      + {static} builder() : JwtBuilder
    }
    interface "SecretKey (javax.crypto)" as SecretKey {
      + getAlgorithm() : String
      + getEncoded() : byte[]
    }
  }
}

class JwtAuthFilter <<Client>> {
  - tokenService : TokenService
  - userDetailsService : UserDetailsService
  # doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain) : void
}

package "Adapter 2: usuario para Spring Security" {
  interface "UserDetailsService (Spring)" as UserDetailsService {
    + loadUserByUsername(String) : UserDetails
  }
  class UserDetailsServiceImpl {
    - usuarioRepository : UsuarioRepository
    + loadUserByUsername(String) : UserDetails
  }
  interface "UserDetails (Spring)" as UserDetails <<Target>> {
    + getAuthorities() : Collection<GrantedAuthority>
    + getPassword() : String
    + getUsername() : String
    + isEnabled() : boolean
  }
  class UsuarioDetails <<Adapter>> {
    - usuario : IUsuario
    + getAuthorities() : Collection<GrantedAuthority>
    + getPassword() : String
    + getUsername() : String
    + isEnabled() : boolean
  }
  interface IUsuario <<Adaptee>> {
    + getUsername() : String
    + getPassword() : String
    + getRol() : Rol
    + isActivo() : boolean
    + desactivar() : void
    + reactivar() : void
  }
}

AuthController --> "1" AuthService : authService
AdminServiceImpl --> "1" AuthService : authService
AuthService <|.. AuthServiceImpl
AuthServiceImpl --> "1" AuthenticationManager
AuthServiceImpl --> "1" PasswordEncoder
AuthServiceImpl --> "1" UsuarioRepository
AuthServiceImpl --> "1" TokenService

JwtAuthFilter --> "1" TokenService
TokenService <|.. JwtUtil
JwtUtil *-- "1" JwtParser : parser
JwtUtil *-- "1" SecretKey : key
JwtUtil ..> Jwts : builder()

JwtAuthFilter --> "1" UserDetailsService
UserDetailsService <|.. UserDetailsServiceImpl
UserDetailsServiceImpl --> "1" UsuarioRepository
UserDetailsServiceImpl ..> UsuarioDetails : crea
UserDetails <|.. UsuarioDetails
UsuarioDetails o--> "1" IUsuario : usuario

note right of AuthServiceImpl
  Facade: cuatro operaciones de negocio sobre
  Spring Security, BCrypt, el repositorio y JWT.
  Dos clientes: AuthController (registro, login)
  y AdminServiceImpl (alta con rol); un solo crear().
  Ningún controlador importa el subsistema.
  También es Client del Adapter 1.
end note
note left of JwtUtil
  Object Adapter: implementa el Target,
  compone el JwtParser de jjwt y firma
  con Jwts.builder().
  Única clase que importa jjwt.
end note
note bottom of IUsuario
  Object Adapter: Spring Security pide
  UserDetails; envuelve al IUsuario
  del dominio. Los controllers reciben
  el IUsuario, no el Adapter:
  @AuthenticationPrincipal(expression = "usuario").
  isEnabled() traduce isActivo() (baja lógica):
  login 401 y JwtAuthFilter descarta el token.
end note
@enduml

@startuml clases-v4-modelo
!pragma layout elk
title Dashboard de préstamos V4 — diagrama de clases del dominio
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 70
set separator none
hide empty members

package "model.cliente" {
  interface ICliente {
    + getDni() : String
    + getNombre() : String
  }
  class Cliente <<Entity>> {
    - dni : String
    - nombre : String
    - Cliente(dni : String, nombre : String)
    + {static} nuevo(dni : String, nombre : String) : Cliente
    + getDni() : String
    + getNombre() : String
  }
}

package "model.credito" {
  interface Deuda <<Component>> {
    + saldo() : BigDecimal
    + montoVencido() : BigDecimal
    + tieneMora() : boolean
  }
  interface ICredito {
    + getId() : Long
    + getCliente() : ICliente
    + getFecha() : LocalDate
    + getCondiciones() : ICondicionesDeCredito
    + importeCuota() : BigDecimal
    + isAnulado() : boolean
    + totalADevolver() : BigDecimal
    + getCuotas() : List<? extends ICuota>
    + estado() : EstadoCredito
    + puedeAnularse() : boolean
    + anular() : void
  }
  interface ICuota {
    + getId() : Long
    + getCredito() : ICredito
    + getNumero() : Integer
    + getImporte() : BigDecimal
    + getFechaVencimiento() : LocalDate
    + estaPagada() : boolean
    + estaVencida() : boolean
    + registrarCobranza(importe : BigDecimal) : ICobranza
  }
  interface ICobranza {
    + getId() : Long
    + getCuota() : ICuota
    + getImporte() : BigDecimal
    + getFechaCobranza() : LocalDate
    + isAnulada() : boolean
    + anular() : void
  }
  interface ICondicionesDeCredito {
    + getDeudaOriginal() : BigDecimal
    + getTasaInteres() : BigDecimal
    + getCantidadCuotas() : Integer
    + getTipoPlan() : TipoPlan
    + getCargos() : Set<TipoCargo>
    + desglose() : List<Renglon>
  }
  class Cartera <<Composite>> {
    - deudas : List<Deuda>
    - Cartera(deudas : List<Deuda>)
    + {static} de(deudas : List<? extends Deuda>) : Cartera
    + saldo() : BigDecimal
    + montoVencido() : BigDecimal
    - sumar(monto : Function<Deuda, BigDecimal>) : BigDecimal
  }
  class Credito <<Entity / Composite>> {
    - id : Long
    - cliente : Cliente
    - fecha : LocalDate
    - condiciones : CondicionesDeCredito
    - anulado : boolean
    - cuotas : List<Cuota>
    - Credito(cliente : Cliente, fecha : LocalDate, condiciones : CondicionesDeCredito)
    + {static} nuevo(cliente : Cliente, fecha : LocalDate, condiciones : CondicionesDeCredito) : Credito
    + getId() : Long
    + getCliente() : Cliente
    + getFecha() : LocalDate
    + getCondiciones() : CondicionesDeCredito
    + isAnulado() : boolean
    + getCuotas() : List<Cuota>
    + totalADevolver() : BigDecimal
    + importeCuota() : BigDecimal
    - generarPlanDeCuotas() : void
    + estado() : EstadoCredito
    + saldo() : BigDecimal
    + montoVencido() : BigDecimal
    - sumar(monto : Function<Cuota, BigDecimal>) : BigDecimal
    - estaCancelado() : boolean
    - tieneCobranzas() : boolean
    + puedeAnularse() : boolean
    + anular() : void
  }
  class Cuota <<Entity / Leaf>> {
    - id : Long
    - credito : Credito
    - numero : Integer
    - importe : BigDecimal
    - fechaVencimiento : LocalDate
    - cobranzas : List<Cobranza>
    ~ Cuota(credito : Credito, numero : Integer, importe : BigDecimal, fechaVencimiento : LocalDate)
    + getId() : Long
    + getCredito() : Credito
    + getNumero() : Integer
    + getImporte() : BigDecimal
    + getFechaVencimiento() : LocalDate
    + estaPagada() : boolean
    + estaVencida() : boolean
    + estaVencida(hoy : LocalDate) : boolean
    + saldo() : BigDecimal
    + montoVencido() : BigDecimal
    + registrarCobranza(importe : BigDecimal) : Cobranza
  }
  class Cobranza <<Entity>> {
    - id : Long
    - cuota : Cuota
    - importe : BigDecimal
    - fechaCobranza : LocalDate
    - anulada : boolean
    - Cobranza(cuota : Cuota, importe : BigDecimal)
    ~ {static} registrar(cuota : Cuota, importe : BigDecimal) : Cobranza
    + getId() : Long
    + getCuota() : Cuota
    + getImporte() : BigDecimal
    + getFechaCobranza() : LocalDate
    + isAnulada() : boolean
    + anular() : void
    + anular(hoy : LocalDate) : void
  }
  class CondicionesDeCredito <<Embeddable / Context>> {
    - deudaOriginal : BigDecimal
    - tasaInteres : BigDecimal
    - cantidadCuotas : Integer
    - tipoPlan : TipoPlan
    - cargos : Set<TipoCargo>
    + CondicionesDeCredito(deudaOriginal : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : Integer, tipoPlan : TipoPlan, cargos : Set<TipoCargo>)
    + getDeudaOriginal() : BigDecimal
    + getTasaInteres() : BigDecimal
    + getCantidadCuotas() : Integer
    + getTipoPlan() : TipoPlan
    + getCargos() : Set<TipoCargo>
    ~ importeCuota() : BigDecimal
    + desglose() : List<Renglon>
    - calculo() : CalculoDeCuota
  }
  enum EstadoCredito {
    VIGENTE
    CANCELADO
    ANULADO
  }
}

package "model.plan" {
  interface CalculoDeCuota <<Strategy / Component>> {
    + importeCuota(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : BigDecimal
    + desglose(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : List<Renglon>
  }
  enum TipoPlan {
    INTERES_SIMPLE
    SISTEMA_FRANCES
    - calculo : CalculoDeCuota
    - TipoPlan(calculo : CalculoDeCuota)
    + calculo() : CalculoDeCuota
  }
  enum TipoCargo {
    SEGURO_DE_VIDA
    GASTO_DE_ADMINISTRACION
    + {abstract} aplicarSobre(calculo : CalculoDeCuota) : CalculoDeCuota
  }
  class InteresSimple <<ConcreteStrategy / ConcreteComponent>> {
    - {static} CIEN : BigDecimal
    - totalADevolver(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : BigDecimal
    + importeCuota(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : BigDecimal
    + desglose(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : List<Renglon>
  }
  class SistemaFrances <<ConcreteStrategy / ConcreteComponent>> {
    - {static} CIEN : BigDecimal
    - {static} PRECISION : MathContext
    + importeCuota(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : BigDecimal
    + desglose(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : List<Renglon>
  }
  abstract class CargoSobreCuota <<Decorator>> {
    - envuelto : CalculoDeCuota
    # CargoSobreCuota(envuelto : CalculoDeCuota)
    + importeCuota(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : BigDecimal
    + desglose(capital : BigDecimal, tasaInteres : BigDecimal, cantidadCuotas : int) : List<Renglon>
    # {abstract} nombre() : String
    # {abstract} cargo(capital : BigDecimal, cantidadCuotas : int) : BigDecimal
  }
  class SeguroDeVida <<ConcreteDecorator>> {
    - {static} PORCENTAJE_POR_CUOTA : BigDecimal
    + SeguroDeVida(envuelto : CalculoDeCuota)
    # nombre() : String
    # cargo(capital : BigDecimal, cantidadCuotas : int) : BigDecimal
  }
  class GastoDeAdministracion <<ConcreteDecorator>> {
    - {static} MONTO_POR_CUOTA : BigDecimal
    + GastoDeAdministracion(envuelto : CalculoDeCuota)
    # nombre() : String
    # cargo(capital : BigDecimal, cantidadCuotas : int) : BigDecimal
  }
  class Renglon <<record>> {
    - concepto : String
    - importe : BigDecimal
    + Renglon(concepto : String, importe : BigDecimal)
    + concepto() : String
    + importe() : BigDecimal
  }
}

package "model.usuario" {
  interface IUsuario {
    + getId() : Long
    + getUsername() : String
    + getPassword() : String
    + getRol() : Rol
    + getPermisos() : IPermisos
    + isActivo() : boolean
    + puedeAnularCredito() : boolean
    + puedeAnularCobranza() : boolean
    + otorgarPermisos(permisos : IPermisos) : void
    + asignarRol(rol : Rol) : void
    + desactivar() : void
    + reactivar() : void
  }
  interface IPermisos {
    + isPuedeAnularCredito() : boolean
    + isPuedeAnularCobranza() : boolean
  }
  interface IRol {
    + autoridad() : String
  }
  class Usuario <<Entity>> {
    - id : Long
    - username : String
    - password : String
    - rol : Rol
    - permisos : Permisos
    - activo : boolean
    - Usuario(username : String, passwordHasheado : String, rol : Rol, permisos : Permisos)
    + {static} nuevo(username : String, passwordHasheado : String, rol : Rol, permisos : Permisos) : Usuario
    + getId() : Long
    + getUsername() : String
    + getPassword() : String
    + getRol() : Rol
    + getPermisos() : Permisos
    + isActivo() : boolean
    + puedeAnularCredito() : boolean
    + puedeAnularCobranza() : boolean
    + otorgarPermisos(permisos : IPermisos) : void
    + asignarRol(rol : Rol) : void
    + desactivar() : void
    + reactivar() : void
  }
  class Permisos <<Embeddable>> {
    - puedeAnularCredito : boolean
    - puedeAnularCobranza : boolean
    - Permisos(puedeAnularCredito : boolean, puedeAnularCobranza : boolean)
    + {static} de(puedeAnularCredito : boolean, puedeAnularCobranza : boolean) : Permisos
    + {static} ninguno() : Permisos
    + {static} todos() : Permisos
    + isPuedeAnularCredito() : boolean
    + isPuedeAnularCobranza() : boolean
  }
  enum Rol {
    ADMIN
    SUPERVISOR
    USER
    + autoridad() : String
  }
}

' Layout: credito arriba, plan y cliente al costado, usuario abajo

package "service.impl" {
  class CreditoServiceImpl <<Service>> {
    - creditoRepository : CreditoRepository
    - clienteRepository : ClienteRepository
    + crear(request : CreditoRequest) : CreditoResponse
    + buscarPorId(id : Long) : CreditoResponse
    + listarTodos() : List<CreditoResponse>
    + listarPorCliente(dniCliente : String) : List<CreditoResponse>
    + anularCredito(id : Long, usuario : IUsuario) : void
    - buscarCliente(dni : String) : Cliente
    - buscarCredito(id : Long) : Credito
  }
  class CobranzaServiceImpl <<Service>> {
    - cobranzaRepository : CobranzaRepository
    - cuotaRepository : CuotaRepository
    - creditoRepository : CreditoRepository
    + registrar(request : CobranzaRequest) : CobranzaResponse
    + listarPorCredito(idCredito : Long) : List<CobranzaResponse>
    + anularCobranza(id : Long, usuario : IUsuario) : void
  }
}

' Realizaciones y herencia
ICliente <|.. Cliente : implementa
Deuda <|-- ICredito : extiende
Deuda <|-- ICuota : extiende
Deuda <|.. Cartera : implementa
ICredito <|.. Credito : implementa
ICuota <|.. Cuota : implementa
ICobranza <|.. Cobranza : implementa
ICondicionesDeCredito <|.. CondicionesDeCredito : implementa
CalculoDeCuota <|.. InteresSimple : implementa
CalculoDeCuota <|.. SistemaFrances : implementa
CalculoDeCuota <|.. CargoSobreCuota : implementa
CargoSobreCuota <|-- SeguroDeVida : extiende
CargoSobreCuota <|-- GastoDeAdministracion : extiende
IUsuario <|.. Usuario : implementa
IPermisos <|.. Permisos : implementa
IRol <|.. Rol : implementa

' Asociaciones del dominio (se leen de izquierda a derecha siguiendo >)
Cartera "0..*" o--> "0..*" Deuda : agrupa >
