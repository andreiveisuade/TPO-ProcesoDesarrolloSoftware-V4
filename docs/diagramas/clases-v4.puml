@startuml clases-v4-seguridad
title Dashboard de préstamos V4 — seguridad: Facade y Adapter
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "controller" {
  class AuthController <<RestController>> {
    - authService : AuthService
    + registrar(request : RegisterRequest) : ResponseEntity<AuthResponse>
    + login(request : LoginRequest) : ResponseEntity<AuthResponse>
    + actual(usuario : IUsuario) : ResponseEntity<AuthResponse>
  }
}

package "service" {
  interface AuthService {
    + registrar(request : RegisterRequest) : AuthResponse
    + registrarConRol(request : RegisterRequest, rol : Rol) : UsuarioResponse
    + login(request : LoginRequest) : AuthResponse
    + actual(username : String) : AuthResponse
  }
  interface TokenService {
    + generarToken(username : String) : String
    + extraerUsername(token : String) : Optional<String>
  }
}

package "service.impl" {
  class AuthServiceImpl <<Service>> {
    - usuarioRepository : UsuarioRepository
    - passwordEncoder : PasswordEncoder
    - authenticationManager : AuthenticationManager
    - tokenService : TokenService
    + registrar(request : RegisterRequest) : AuthResponse
    + registrarConRol(request : RegisterRequest, rol : Rol) : UsuarioResponse
    + login(request : LoginRequest) : AuthResponse
    + actual(username : String) : AuthResponse
    - crear(request : RegisterRequest, rol : Rol) : Usuario
    - buscar(username : String) : Usuario
  }
  class AdminServiceImpl
}

package "repository" {
  interface UsuarioRepository
}

package "security" {
  class JwtAuthFilter <<Component>> {
    - {static} PREFIJO_BEARER : String
    - tokenService : TokenService
    - userDetailsService : UserDetailsService
    # doFilterInternal(request : HttpServletRequest, response : HttpServletResponse, filterChain : FilterChain) : void
    - extraerToken(request : HttpServletRequest) : String
    - faltaAutenticar() : boolean
    - autenticar(token : String, request : HttpServletRequest) : void
  }
  class JwtUtil <<Component>> {
    - key : SecretKey
    - parser : JwtParser
    - expirationMs : long
    + JwtUtil(secret : String, expirationMs : long)
    + generarToken(username : String) : String
    + extraerUsername(token : String) : Optional<String>
    - <T> extraerClaim(token : String, resolver : Function<Claims, T>) : T
  }
  class UserDetailsServiceImpl <<Service>> {
    - usuarioRepository : UsuarioRepository
    + loadUserByUsername(username : String) : UserDetails
  }
  class UsuarioDetails {
    - usuario : IUsuario
    + UsuarioDetails(usuario : IUsuario)
    + getUsuario() : IUsuario
    + getAuthorities() : Collection<GrantedAuthority>
    + getPassword() : String
    + getUsername() : String
    + isEnabled() : boolean
  }
}

package "spring y jjwt" {
  abstract class OncePerRequestFilter <<Spring Web>> {
    # {abstract} doFilterInternal(request : HttpServletRequest, response : HttpServletResponse, filterChain : FilterChain) : void
  }
  interface AuthenticationManager <<Spring Security>> {
    + authenticate(authentication : Authentication) : Authentication
  }
  interface PasswordEncoder <<Spring Security>> {
    + encode(rawPassword : CharSequence) : String
    + matches(rawPassword : CharSequence, encodedPassword : String) : boolean
  }
  interface UserDetailsService <<Spring Security>> {
    + loadUserByUsername(username : String) : UserDetails
  }
  interface UserDetails <<Spring Security>> {
    + getAuthorities() : Collection<GrantedAuthority>
    + getPassword() : String
    + getUsername() : String
    + isEnabled() : boolean
  }
  interface JwtParser <<jjwt>> {
    + parseSignedClaims(jws : CharSequence) : Jws<Claims>
  }
  class Jwts <<jjwt>> {
    + {static} builder() : JwtBuilder
    + {static} parser() : JwtParserBuilder
  }
  interface SecretKey <<javax.crypto>> {
    + getAlgorithm() : String
    + getEncoded() : byte[]
  }
}

AuthService <|.. AuthServiceImpl : implementa
TokenService <|.. JwtUtil : implementa
UserDetailsService <|.. UserDetailsServiceImpl : implementa
UserDetails <|.. UsuarioDetails : implementa
OncePerRequestFilter <|-- JwtAuthFilter : extiende

AuthController "0..*" --> "1" AuthService : delega en
AuthController "1" ..> "1" IUsuario : recibe al autenticado como
AdminServiceImpl "0..*" --> "1" AuthService : da de alta con
AuthService ..> Rol : recibe

AuthServiceImpl "0..*" --> "1" AuthenticationManager : autentica con
AuthServiceImpl "0..*" --> "1" PasswordEncoder : cifra la clave con
AuthServiceImpl "0..*" --> "1" UsuarioRepository : guarda y busca en
AuthServiceImpl "0..*" --> "1" TokenService : emite el token con
AuthServiceImpl "1" ..> "0..*" Usuario : crea
AuthServiceImpl "1" ..> "1" Permisos : inicializa

ApiClient "1" ..> "1" JwtAuthFilter : envía el token Bearer a
JwtAuthFilter "0..*" --> "1" TokenService : valida el token con
JwtAuthFilter "0..*" --> "1" UserDetailsService : carga al usuario con
JwtAuthFilter "1" ..> "0..1" UserDetails : autentica a

JwtUtil "1" *--> "1" JwtParser : valida con
JwtUtil "1" *--> "1" SecretKey : firma con
JwtUtil "1" ..> "1" Jwts : arma el token con

UserDetailsServiceImpl "0..*" --> "1" UsuarioRepository : busca en
UserDetailsServiceImpl "1" ..> "0..*" UsuarioDetails : crea
UserDetailsService ..> UserDetails : devuelve
UsuarioDetails "0..*" o--> "1" IUsuario : adapta a
@enduml

