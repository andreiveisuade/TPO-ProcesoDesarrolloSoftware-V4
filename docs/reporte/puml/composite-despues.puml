@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
hide empty members
interface Deuda <<Component>> {
  +saldo() : BigDecimal
  +montoVencido() : BigDecimal
}
class Cuota <<Leaf>> {
  +saldo() : BigDecimal
  +montoVencido() : BigDecimal
}
class Credito <<Composite>> {
  -cuotas : List<Cuota>
  +saldo() : BigDecimal
  +montoVencido() : BigDecimal
}
class Cartera <<Composite>> {
  -deudas : List<Deuda>
  +{static} de(deudas) : Cartera
  +saldo() : BigDecimal
  +montoVencido() : BigDecimal
}
class "DashboardServiceImpl\nCreditoServiceImpl\nClienteServiceImpl" as Clientes <<Client>>
Deuda <|.. Cuota
Deuda <|.. Credito
Deuda <|.. Cartera
Credito *-- "1..*" Cuota
Cartera o-- "0..*" Deuda
Clientes ..> Cartera : Cartera.de(creditos)
@enduml
