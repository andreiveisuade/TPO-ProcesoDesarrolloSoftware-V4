@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
hide empty members
class AuthController {
  +actual(principal)
}
interface AuthService {
  +registrar(request)
  +login(request)
  +actual(username)
}
class AuthServiceImpl
class AdminServiceImpl {
  +listarUsuarios()
  +actualizarRol(id, request)
}
interface UsuarioRepository
interface "AuthenticationManager (Spring)" as AM
interface "PasswordEncoder (Spring)" as PE
interface TokenService
AuthController --> AuthService
AuthService <|.. AuthServiceImpl
AuthServiceImpl --> AM
AuthServiceImpl --> PE
AuthServiceImpl --> TokenService
AdminServiceImpl --> UsuarioRepository
note right of AdminServiceImpl #FFE0E0
  sin alta de usuarios:
  un solo cliente de la Facade
end note
@enduml
