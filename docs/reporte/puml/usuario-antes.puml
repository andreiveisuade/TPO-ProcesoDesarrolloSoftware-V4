@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
hide empty members
set separator none
package model.interfaces {
  interface IUsuario {
    +otorgarPermisos(Permisos) : void
    +asignarRol(Rol) : void
  }
  interface IPermisos
}
package model {
  class Usuario {
    -permisos : Permisos
  }
  class Permisos <<Embeddable>>
}
IUsuario <|.. Usuario
IPermisos <|.. Permisos
Usuario *-- Permisos
IUsuario ..> Permisos : import de la\nclase concreta
@enduml
