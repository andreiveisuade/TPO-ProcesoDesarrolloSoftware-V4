@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
hide empty members
class Credito <<Context / Composite>> {
  -deudaOriginal : BigDecimal
  -tasaInteres : BigDecimal
  -cantidadCuotas : Integer
  -tipoPlan : TipoPlan
  -cargos : Set<TipoCargo>
  -fecha : LocalDate
  -importeCuota : BigDecimal
  -anulado : boolean
  +{static} nuevo(cliente, deudaOriginal, fecha,\n  tasaInteres, cantidadCuotas, tipoPlan, cargos)
  -calculo() : CalculoDeCuota
  +saldo() / montoVencido()
  +estado() / anular() / puedeAnularse()
  +estaCancelado() : boolean
  +tieneCobranzas() : boolean
}
interface CalculoDeCuota <<Strategy>>
class Cuota <<Leaf>>
Credito ..> CalculoDeCuota : calculo()
Credito *-- "1..*" Cuota
note bottom of Credito #FFE0E0
  7 parámetros en nuevo(...);
  precio de la cuota + suma de deuda + ciclo de vida;
  estaCancelado/tieneCobranzas públicos sin uso externo
end note
@enduml
